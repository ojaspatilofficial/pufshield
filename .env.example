# PUFShield environment configuration
# Copy to .env and adjust values. Never commit secrets.

# FastAPI server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true

# SQLite database file (relative to project root)
DATABASE_PATH=data/pufshield.db

# Server-side PUF credential secret file (relative to project root)
PUF_CREDENTIAL_SECRET_PATH=data/puf_secret.bin

# Secure boot
BOOT_CERTIFICATE_VALID_DAYS=730
CA_CERTIFICATE_VALID_DAYS=3650
INTERMEDIATE_CERTIFICATE_VALID_DAYS=1825

# Device provisioning
DEVICE_KEY_SIZE_BYTES=32

# Logging
LOG_LEVEL=INFO
